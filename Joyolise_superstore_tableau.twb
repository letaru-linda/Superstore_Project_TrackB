        <zone forceUpdate='true' h='3556' id='91' type-v2='text' w='98417' x='1250' y='38111'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Sales and profit trended upward from 2011–2014, though slower profit growth indicates potential margin pressure.</run>
          </formatted-text>
        </zone>
        <zone h='4667' id='92' type-v2='text' w='49333' x='583' y='67111'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>Revenue is heavily concentrated in Q4, particularly in APAC and EU regions, highlighting strong year-end seasonal demand</run>
          </formatted-text>
        </zone>
        <zone h='4667' id='93' type-v2='text' w='49417' x='417' y='94889'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>The Consumer segment remains the largest revenue contributor, with all customer segments showing steady year-over-year growth.</run>
          </formatted-text>
        </zone>
        <zone h='4667' id='94' type-v2='text' w='49750' x='50250' y='95222'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>Revenue increased every year, reaching $4.30M in 2014, with annual growth accelerating from $0.42M to $0.89M.</run>
          </formatted-text>
        </zone>
        <zone h='5667' id='95' type-v2='text' w='49583' x='50250' y='66333'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='8'>Standard Class experiences the longest delivery times and highest delays, while Same Day and First Class maintain excellent on-time performance.</run>
          </formatted-text>
        </zone>
      </zones>
