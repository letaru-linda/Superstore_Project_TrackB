            </column-instance>
            <column-instance column='[Market]' derivation='None' name='[none:Market:nk]' pivot='key' type='nominal' />
            <column-instance column='[Order_Year]' derivation='None' name='[none:Order_Year:ok]' pivot='key' type='ordinal' />
