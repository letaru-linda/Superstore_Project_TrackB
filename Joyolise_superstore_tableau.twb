    <worksheet name='YoYGrowth'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='16'>Year-Over-Year Growth</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Global_Superstore2 (DAHEL FINAL PROJECT)' name='federated.0wt0wbq0h1f5od131h4sz0xtgfsv' />
          </datasources>
          <datasource-dependencies datasource='federated.0wt0wbq0h1f5od131h4sz0xtgfsv'>
            <column caption='YoY' datatype='string' name='[Calculation_0509358028705795]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Sales])-LOOKUP(SUM([Sales]),-1) &gt; 0 THEN &quot;Increase&quot; ELSE &quot;Decrease&quot; END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Market]' role='dimension' type='nominal' />
            <column caption='Order Date' datatype='date' name='[Order_Date]' role='dimension' type='ordinal' />
            <column caption=' Year' datatype='integer' name='[Order_Year]' role='dimension' type='quantitative' />
            <column datatype='real' default-format='n&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Sales]' role='measure' type='quantitative' />
            <column caption='Sub Category' datatype='string' name='[Sub_Category]' role='dimension' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[cum:sum:Sales:qk]' pivot='key' type='quantitative'>
