      <aliases enabled='yes' />
      <column caption='Profit Status' datatype='string' name='[Calculation_0195720688128000]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;=0 THEN &quot;PROFIT&quot; ELSE &quot;LOSS&quot; END' />
      </column>
      <column caption='YoY' datatype='string' name='[Calculation_0509358028705795]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales])-LOOKUP(SUM([Sales]),-1) &gt; 0 THEN &quot;Increase&quot; ELSE &quot;Decrease&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_0509358202986501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ ID])' />
      </column>
      <column caption='Shipping Status' datatype='string' name='[Calculation_0570930471153664]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Days_to_Ship] &lt;= 4 THEN &quot;On Tim&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='Profit Margin%' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_0759496406097920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales]) * 100' />
      </column>
      <column caption='Profit Stat' datatype='string' name='[Calculation_0759496410210305]' role='measure' type='nominal'>
